{
  "//": "Sample SQL Data Manager configuration. Copy the Modules:SqlDataManager section into your host appsettings.json and supply the connection password via an environment variable or secret store (never commit real credentials).",
  "Modules": {
    "SqlDataManager": {
      "Enabled": true,
      "DisplayName": "SQL Data Manager",
      "ApiRoutePrefix": "/api/sql-data-manager",

      "Connection": {
        "Server": "SQLSERVER01",
        "Database": "ApplicationDatabase",
        "AuthenticationType": "Windows",
        "Username": "",
        "Password": "",
        "Encrypt": true,
        "TrustServerCertificate": false,
        "ConnectionTimeoutSeconds": 30,
        "CommandTimeoutSeconds": 60,
        "ApplicationName": "SqlDataManager",
        "MetadataCacheSeconds": 300
      },

      "DataDisplay": {
        "DefaultPageSize": 100,
        "AllowedPageSizes": [ 25, 50, 100, 250, 500 ],
        "MaximumPageSize": 500,
        "MaximumDisplayedTextLength": 5000,
        "ExactRowCountMode": "OnDemand"
      },

      "Crud": {
        "EnableCreate": true,
        "EnableUpdate": true,
        "EnableDelete": true,
        "RequireCreateConfirmation": true,
        "RequireUpdateConfirmation": true,
        "RequireDeleteConfirmation": true,
        "RequireTypedDeleteConfirmation": false,
        "AllowBulkDelete": false,
        "MaximumBulkDeleteRows": 20
      },

      "ObjectAccess": {
        "DefaultTableAccess": "ReadOnly",
        "DefaultViewAccess": "ReadOnly",
        "AllowedSchemas": [ "dbo", "sales" ],
        "DeniedSchemas": [ "internal" ],
        "AllowedObjects": [],
        "DeniedObjects": [ "dbo.AuditLog", "dbo.Users" ]
      },

      "ObjectPermissions": {
        "dbo.Customers": { "Read": true, "Create": true, "Update": true, "Delete": false },
        "sales.Orders": { "Read": true, "Create": true, "Update": true, "Delete": true }
      },

      "ObjectSensitivity": {
        "dbo.Customers": {
          "SensitiveColumns": {
            "NationalId": "Masked",
            "PasswordHash": "Hidden"
          }
        }
      },

      "SettingsStorage": {
        "Provider": "JsonFile",
        "Directory": "AppData/SqlDataManager",
        "AutoSave": true,
        "SaveDebounceMilliseconds": 750
      },

      "Security": {
        "RequireAuthentication": false,
        "ReadPolicy": "SqlDataManager.Read",
        "CreatePolicy": "SqlDataManager.Create",
        "UpdatePolicy": "SqlDataManager.Update",
        "DeletePolicy": "SqlDataManager.Delete"
      }
    }
  }
}
