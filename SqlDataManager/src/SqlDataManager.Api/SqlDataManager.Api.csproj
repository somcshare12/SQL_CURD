<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The API project is the module's web layer AND the standalone host. It:
      * exposes AddSqlDataManagerModule / MapSqlDataManagerEndpoints so a parent
        ASP.NET Core app can embed the module with one line each,
      * contains the minimal-API endpoints, exception middleware, health
        endpoints, OpenAPI, CORS, rate limiting and request-size limiting,
      * ships a Program.cs that runs the module as a self-contained application.
  -->
  <PropertyGroup>
    <RootNamespace>SqlDataManager.Api</RootNamespace>
    <AssemblyName>SqlDataManager.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlDataManager.Domain\SqlDataManager.Domain.csproj" />
    <ProjectReference Include="..\SqlDataManager.Application\SqlDataManager.Application.csproj" />
    <ProjectReference Include="..\SqlDataManager.Infrastructure\SqlDataManager.Infrastructure.csproj" />
    <ProjectReference Include="..\SqlDataManager.Contracts\SqlDataManager.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
  </ItemGroup>

</Project>
